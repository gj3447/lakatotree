{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lakatotree.dev/schema/scientific-backtest-replayer-allowlist-v1.json",
  "title": "LakatoTree external replay allow-list v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "replayer_dids", "owner", "separation_attestation_sha256"],
  "properties": {
    "schema_version": {"const": "lakatotree-replayer-allowlist/v1"},
    "replayer_dids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^did:key:"}
    },
    "owner": {"type": "string", "minLength": 1},
    "separation_attestation_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
  }
}

{
  "schema_version": "fsm-spec/v1",
  "name": "frontier-question-lifecycle",
  "execution": {
    "step_interface": "step(configuration, typed_event) -> next_configuration, effect_commands",
    "event_queue": "API commands are reduced one at a time against the persisted question state.",
    "run_to_completion": "One event selects at most one transition before the next command.",
    "action_order": "Read persisted state, reduce purely, then commit the declared effect atomically."
  },
  "context_schema": {},
  "event_schemas": {
    "OPEN": {
      "type": "object",
      "required": ["tree", "question", "event_id"],
      "properties": {
        "tree": {"type": "string"},
        "question": {"type": "string"},
        "event_id": {"type": "string"}
      }
    },
    "CLOSE": {
      "type": "object",
      "required": ["tree", "question", "event_id"],
      "properties": {
        "tree": {"type": "string"},
        "question": {"type": "string"},
        "event_id": {"type": "string"}
      }
    },
    "ADJUDICATED": {
      "type": "object",
      "required": ["tree", "question", "verdict", "receipt_sha"],
      "properties": {
        "tree": {"type": "string"},
        "question": {"type": "string"},
        "verdict": {"type": "string"},
        "receipt_sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "guards": {
    "receipt_backed_conclusive": {
      "reads": [],
      "event_reads": ["verdict", "receipt_sha"],
      "pure": true,
      "synchronous": true
    }
  },
  "effects": {
    "UpdateQuestionMetadata": {
      "kind": "command",
      "payload_schema": {
        "type": "object",
        "required": ["tree", "question", "event_id"],
        "properties": {
          "tree": {"type": "string"},
          "question": {"type": "string"},
          "event_id": {"type": "string"}
        }
      }
    },
    "RecordQuestionClosure": {
      "kind": "command",
      "payload_schema": {
        "type": "object",
        "required": ["tree", "question", "event_id"],
        "properties": {
          "tree": {"type": "string"},
          "question": {"type": "string"},
          "event_id": {"type": "string"}
        }
      }
    }
  },
  "machines": [
    {
      "id": "frontier-question",
      "initial": "OPEN",
      "states": [
        {"id": "OPEN", "kind": "atomic"},
        {"id": "CLOSED", "kind": "atomic"}
      ],
      "events": ["OPEN", "CLOSE", "ADJUDICATED"],
      "invalid_event_policy": {
        "mode": "reject",
        "guard_false": "reject",
        "state_change": "none"
      },
      "transitions": [
        {
          "id": "refresh-open",
          "from": "OPEN",
          "event": "OPEN",
          "to": "OPEN",
          "effects": ["UpdateQuestionMetadata"],
          "effect_bindings": {
            "UpdateQuestionMetadata": {
              "tree": "event.tree",
              "question": "event.question",
              "event_id": "event.event_id"
            }
          }
        },
        {
          "id": "close",
          "from": "OPEN",
          "event": "CLOSE",
          "to": "CLOSED",
          "effects": ["RecordQuestionClosure"],
          "effect_bindings": {
            "RecordQuestionClosure": {
              "tree": "event.tree",
              "question": "event.question",
              "event_id": "event.event_id"
            }
          }
        },
        {
          "id": "duplicate-close",
          "from": "CLOSED",
          "event": "CLOSE",
          "to": "CLOSED",
          "effects": [],
          "effect_bindings": {}
        },
        {
          "id": "adjudication-close",
          "from": "OPEN",
          "event": "ADJUDICATED",
          "to": "CLOSED",
          "guard": "receipt_backed_conclusive",
          "priority": 0,
          "effects": ["RecordQuestionClosure"],
          "effect_bindings": {
            "RecordQuestionClosure": {
              "tree": "event.tree",
              "question": "event.question",
              "event_id": "event.receipt_sha"
            }
          }
        },
        {
          "id": "adjudication-retain-open",
          "from": "OPEN",
          "event": "ADJUDICATED",
          "to": "OPEN",
          "priority": 1,
          "effects": [],
          "effect_bindings": {}
        },
        {
          "id": "duplicate-adjudication",
          "from": "CLOSED",
          "event": "ADJUDICATED",
          "to": "CLOSED",
          "effects": [],
          "effect_bindings": {}
        }
      ]
    }
  ],
  "safety_properties": [
    {
      "id": "closed-does-not-reopen",
      "statement": "A CLOSED question cannot return to OPEN through the OPEN command.",
      "verification": "Invalid-event trace, reducer conformance test, and OOPTDD injected-fault oracle."
    },
    {
      "id": "close-is-idempotent",
      "statement": "Repeated CLOSE commands do not increment visits or append closure/history events.",
      "verification": "Duplicate-close trace plus application service contract test."
    },
    {
      "id": "self-report-cannot-close",
      "statement": "An adjudication without a valid content-addressed receipt identity cannot close a question; the application transaction persists that receipt and closure together.",
      "verification": "Guard-false trace, reducer conformance test, service transaction test, and OOPTDD injected-fault oracle."
    }
  ],
  "liveness_properties": [
    {
      "id": "eventual-close",
      "statement": "An OPEN question reaches CLOSED when a CLOSE command or receipt-backed conclusive ADJUDICATED event is delivered.",
      "assumptions": ["A valid event is eventually delivered and persistence is available."],
      "verification": "Open-close abstract trace and service integration test."
    }
  ],
  "trace_fixtures": ["docs/data/frontier_question_fsm.traces.json"],
  "conformance": {
    "implementation_step": "lakatos.frontier_state.step",
    "model_trace_runner": "fsm-design/scripts/run_fsm_traces.py",
    "contract_tests": "tests/test_state_isolation_fsm_20260728.py compares every state/event cell with the semantic source and drives TreeService effects."
  }
}
